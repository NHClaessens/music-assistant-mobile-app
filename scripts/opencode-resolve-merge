#!/bin/bash
# opencode-resolve-merge: Resolve ALL git merge conflicts using opencode CLI
#
# Instead of spoonfeeding individual files, this script gives opencode full
# access to the repo and lets it use its tools (Read, Edit, Grep, etc.) to
# resolve all conflicts in one session. A single compile check runs at the end.
#
# REQUIRES: opencode CLI installed and available in PATH
#
# Usage: ./opencode-resolve-merge \
#   --base <branch> \
#   --head <branch> \
#   --verify-command <cmd> \
#   --max-attempts <n>

set -euo pipefail

# Parse arguments
BASE_BRANCH=""
HEAD_BRANCH=""
VERIFY_CMD=""
MAX_ATTEMPTS=3

while [[ $# -gt 0 ]]; do
    case "$1" in
        --base)        BASE_BRANCH="$2";   shift 2 ;;
        --head)        HEAD_BRANCH="$2";   shift 2 ;;
        --verify-command) VERIFY_CMD="$2"; shift 2 ;;
        --max-attempts)   MAX_ATTEMPTS="$2"; shift 2 ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: $0 --base <branch> --head <branch> --verify-command <cmd> --max-attempts <n>" >&2
            exit 1
            ;;
    esac
done

# Validate required arguments
if [[ -z "$BASE_BRANCH" || -z "$HEAD_BRANCH" ]]; then
    echo "Error: --base and --head are required" >&2
    echo "Usage: $0 --base <branch> --head <branch> [--verify-command <cmd>] [--max-attempts <n>]" >&2
    exit 1
fi

# Verify opencode CLI is available
if ! command -v opencode &> /dev/null; then
    echo "::error::opencode CLI is REQUIRED but not found in PATH"
    exit 1
fi

# Get conflicted files
CONFLICTED_FILES=$(git diff --name-only --diff-filter=U)
if [[ -z "$CONFLICTED_FILES" ]]; then
    echo "No conflicts to resolve."
    exit 0
fi

FILE_LIST=$(echo "$CONFLICTED_FILES" | tr '\n' ', ' | sed 's/,$//')
FILE_COUNT=$(echo "$CONFLICTED_FILES" | wc -l | tr -d ' ')
echo "Found $FILE_COUNT conflicted file(s): $FILE_LIST"

# Build the prompt for opencode
# opencode has full repo access - it can read files, edit them, run commands
read -r -d '' PROMPT << 'PROMPT_TEMPLATE' || true
You are resolving git merge conflicts in a Kotlin Multiplatform project.

The following files have conflict markers from a merge of UPSTREAM into our fork:
PROMPT_TEMPLATE

PROMPT="$PROMPT
Base (upstream): $BASE_BRANCH
Head (our fork): $HEAD_BRANCH

Conflicted files:
$CONFLICTED_FILES

INSTRUCTIONS:
1. Read each conflicted file and understand the conflict markers.
2. For each file, also read the upstream version with: git show $BASE_BRANCH:<filepath>
   and our version with: git show $HEAD_BRANCH:<filepath>
3. Resolve each conflict by merging both sides. Priority rules:
   - PRESERVE all custom features, classes, and logic from our fork (HEAD).
   - ADOPT upstream changes that are bug fixes, dependency updates, new features, or compatibility improvements.
   - When in doubt, keep our version.
4. Edit each file to remove ALL conflict markers and write the resolved content.
5. After resolving all files, verify no conflict markers remain by searching for '<<<<<<' across the repo.

Do NOT explain your changes. Just resolve the conflicts by editing the files directly."

ATTEMPT=1
while [[ $ATTEMPT -le $MAX_ATTEMPTS ]]; do
    echo "========================================"
    echo "Resolution attempt $ATTEMPT of $MAX_ATTEMPTS"
    echo "========================================"

    # Run opencode with full repo access; --auto auto-approves permissions
    # that are not explicitly denied (required in CI, no TTY for prompts)
    opencode run "$PROMPT" \
        --dangerously-skip-permissions \
        2>&1 | tee /tmp/opencode-resolve.log || true

    # Check if any conflict markers remain
    if grep -rq '<<<<<<< \|>>>>>>>' $CONFLICTED_FILES 2>/dev/null; then
        echo "Conflict markers still present after attempt $ATTEMPT"

        if [[ $ATTEMPT -lt $MAX_ATTEMPTS ]]; then
            # On retry, give opencode a targeted follow-up
            STILL_CONFLICTED=$(grep -rl '<<<<<<< \|>>>>>>>' $CONFLICTED_FILES 2>/dev/null || true)
            PROMPT="Some files still have unresolved conflict markers:
$STILL_CONFLICTED

Read each file, find the remaining <<<<<<< / ======= / >>>>>>> markers, and resolve them by editing the files. Remove all conflict markers."
        fi

        ATTEMPT=$((ATTEMPT + 1))
        continue
    fi

    echo "All conflict markers resolved."

    # Run compile verification if a command was provided
    if [[ -n "$VERIFY_CMD" ]]; then
        echo "Verifying resolution compiles..."
        if eval "$VERIFY_CMD" 2>&1; then
            echo "Compile verification passed."
        else
            echo "::warning::Compile verification failed, but all conflicts were resolved."
            echo "The build step later in the workflow will catch real errors."
        fi
    fi

    # Stage all resolved files
    echo "$CONFLICTED_FILES" | xargs git add
    echo "All $FILE_COUNT conflicted file(s) resolved and staged."
    exit 0
done

echo "::error::Failed to resolve all conflicts after $MAX_ATTEMPTS attempts"
# List which files still have markers
grep -rl '<<<<<<< \|>>>>>>>' $CONFLICTED_FILES 2>/dev/null | while read -r f; do
    echo "::error file=$f::Conflict markers remain"
done
exit 1
